{
	"name": "newtrino",
	"version": "2.8.0",
	"description": "A Simple Flat-File Content Managing System",
	"keywords": [
		"cms",
		"flat-file"
	],
	"author": "Takuto Yanagida",
	"license": "MIT",
	"scripts": {
		"postinstall": "composer i && node build.mjs build",
		"composer": "composer i",
		"build": "node build.mjs build",
		"start": "node build.mjs"
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not ie <= 11",
		"not dead"
	],
	"dependencies": {
		"autoprefixer": "^10.6.1",
		"flatpickr": "^4.6.13",
		"jssha": "^3.3.2",
		"luxon": "^3.7.2",
		"nacss-reset": "github:takty/nacss-reset",
		"postcss": "^8.5.28",
		"sass": "^1.105.1",
		"terser": "^5.51.2",
		"tinymce": "^6.8.6",
		"tinymce-i18n": "^26.9.28"
	},
	"packageManager": "yarn@4.18.0"
}

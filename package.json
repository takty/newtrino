{
	"name": "newtrino",
	"version": "2.7.3",
	"description": "A Simple Flat-File Content Managing System",
	"keywords": [
		"cms",
		"flat-file"
	],
	"author": "Takuto Yanagida",
	"license": "MIT",
	"scripts": {
		"postinstall": "composer i && node build.mjs build",
		"composer": "composer i",
		"build": "node build.mjs build",
		"start": "node build.mjs"
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not ie <= 11",
		"not dead"
	],
	"dependencies": {
		"autoprefixer": "^10.5.4",
		"current-git-branch": "^2.0.2",
		"flatpickr": "^4.6.13",
		"jssha": "^3.3.2",
		"luxon": "^3.7.2",
		"nacss-reset": "github:takty/nacss-reset",
		"postcss": "^8.5.26",
		"sass": "^1.103.0",
		"terser": "^5.50.0",
		"tinymce": "^5.10.9",
		"tinymce-i18n": "^24.3.11"
	},
	"packageManager": "yarn@4.18.0"
}
